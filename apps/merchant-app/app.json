{
  "expo": {
    "name": "SirfBazar Merchant",
    "slug": "sirfbazar-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "sirfbazar-merchant",
    "icon": "./assets/brand/sirfbazar-app-icon-green.png",
    "splash": {
      "image": "./assets/brand/sirfbazar-reverse.png",
      "backgroundColor": "#009966",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.sirfbazar.merchant"
    },
    "android": {
      "package": "pk.sirfbazar.merchant",
      "icon": "./assets/brand/app-icons/merchant/icon-1024.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icons/merchant/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/app-icons/merchant/adaptive-background.png",
        "backgroundColor": "#009966",
        "monochromeImage": "./assets/brand/app-icons/merchant/monochrome.png"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SirfBazar Merchant uses your location to pin your shop on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SirfBazar Merchant needs photo access to add your shop-front picture.",
          "cameraPermission": "SirfBazar Merchant needs camera access to take your shop-front picture."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "3dd9ec80-1b9c-418a-bfb2-fc124b20a765"
      }
    }
  }
}
