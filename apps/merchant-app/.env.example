# A physical device needs a reachable development host; localhost is for local tooling.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
# Shared Web client, also configured as GOOGLE_CLIENT_ID in apps/api.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=453311658725-s55gcpidi4h6kf38hgqhmrku11ha02ts.apps.googleusercontent.com
# Unique iOS client for this app's bundle ID; required before an iOS build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=453311658725-6h8ucua4jvfopqrb6utj1ail4vaphki4.apps.googleusercontent.com
# Android uses a Cloud Console package + certificate SHA-1 registration, not an Android client ID here.
