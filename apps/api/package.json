{
  "name": "sirfbazar-api",
  "version": "1.0.0",
  "description": "SirfBazar hyperlocal marketplace backend API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test:bind": "node --test test/api-bind.test.cjs",
    "test:pos": "node -r ts-node/register/transpile-only --test test/pos-counter.test.cjs",
    "test:remediation": "node -r ts-node/register/transpile-only --test --test-concurrency=1 test/remediation-database.test.cjs test/remediation-upload.test.cjs test/remediation-realtime.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node prisma/seed.ts",
    "seed:merchant-orders": "ts-node test/seed-merchant-orders.ts",
    "import:catalog": "ts-node prisma/import-catalog.ts",
    "import:grocerie-demo": "ts-node prisma/import-grocerie-demo.ts",
    "stock:demo": "ts-node prisma/stock-demo-shops.ts",
    "smoke": "ts-node test/smoke.ts",
    "start:waha": "node scripts/start-with-waha.js",
    "seed:categories": "ts-node prisma/merge-categories.ts",
    "seed:test-order": "ts-node test/seed-single-merchant-order.ts",
    "test:realtime-order": "ts-node test/send-live-merchant-order.ts",
    "test:merchant-document": "ts-node test/merchant-document-upload.ts",
    "test:merchant-mutations": "ts-node test/merchant-mutations.ts",
    "test:merchant-finance": "ts-node test/merchant-finance.ts",
    "test:merchant-replacement": "ts-node test/merchant-replacement.ts",
    "test:merchant-support": "ts-node test/merchant-support.ts",
    "test:merchant-permissions": "ts-node test/merchant-permissions.ts",
    "test:merchant-pagination": "ts-node test/merchant-pagination.ts",
    "test:waha": "ts-node test/waha-otp.service.ts",
    "test:whatsapp": "ts-node test/whatsapp.service.ts && ts-node test/whatsapp-auth.ts",
    "whatsapp:ready": "ts-node scripts/check-whatsapp.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "@types/web-push": "^3.6.4",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
